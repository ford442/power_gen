      "entries": [
        [0, "VF", "uniform"], [1, "VF", "uniform"], [2, "V", "storage-ro"], [3, "F", "uniform"],
        [4, "V", "uniform"], [5, "F", "uniform"], [6, "F", "storage-ro"], [7, "F", "texture-array"], [8, "F", "sampler"]
      ]
    },
    "fluxSegment": {
      "pipelines": [["flux-segment-vert.wgsl", "flux-segment-frag.wgsl"]],
