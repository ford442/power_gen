      "pipelines": [["field-advect-compute.wgsl"]],
      "entries": [[0, "C", "storage"], [1, "C", "uniform"]]
    },
    "transformerFlux": {
      "pipelines": [["transformer-flux-compute.wgsl"]],
      "entries": [[0, "C", "storage"], [1, "C", "uniform"]]
    },
    "choresReduce": {
      "pipelines": [["chores-reduce-f32.wgsl"]],
      "entries": [[0, "C", "storage-ro"], [1, "C", "storage"], [2, "C", "uniform"]]
