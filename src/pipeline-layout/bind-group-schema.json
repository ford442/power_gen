    },
    "energyPipe": {
      "pipelines": [["energy-pipe-vert.wgsl", "energy-pipe-frag.wgsl"]],
      "entries": [[0, "VF", "uniform"], [1, "VF", "uniform"], [2, "V", "storage-ro"]]
    },
    "energyPipeCompute": {
      "pipelines": [["energy-pipe-compute.wgsl"]],
      "entries": [[0, "C", "storage"], [1, "C", "uniform"]]
    },
    "coil": {
      "pipelines": [["coil-vert.wgsl", "coil-frag.wgsl"]],
      "entries": [[0, "VF", "uniform"], [1, "VF", "uniform"], [2, "V", "storage-ro"], [3, "F", "uniform"]]
    },
    "particleCompute": {
      "pipelines": [["particle-compute.wgsl"]],
      "entries": [[0, "C", "storage"], [1, "C", "uniform"]]
