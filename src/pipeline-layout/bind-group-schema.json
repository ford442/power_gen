{
  "$comment": "Source of truth for every @group(0) bind group layout. Entry = [binding, stages, kind, storageTextureFormat?]. stages: V/F/C letters. kinds: uniform | storage | storage-ro | texture | texture-depth | texture-depth-ms | texture-array | storage-texture | storage-texture-array | sampler. 'pipelines' lists the WGSL pass files (src/shaders/passes/) of each pipeline built on the layout. Regenerate: npm run codegen:bindings",
  "layouts": {
    "roller": {
      "pipelines": [["roller-vert.wgsl", "roller-frag.wgsl"]],
      "entries": [[0, "VF", "uniform"], [1, "VF", "uniform"], [2, "V", "storage-ro"], [3, "F", "uniform"], [5, "F", "storage-ro"]]
    },
    "particle": {
      "pipelines": [["particle-vert.wgsl", "particle-frag.wgsl"]],
      "entries": [[0, "VF", "uniform"], [1, "VF", "uniform"], [3, "F", "uniform"], [4, "V", "storage-ro"]]
    },
