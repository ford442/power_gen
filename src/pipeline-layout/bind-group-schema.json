        ["seg-enhanced-vert.wgsl", "seg-enhanced-frag.wgsl"],
        ["flux-segment-vert.wgsl", "flux-segment-frag.wgsl"],
        ["energy-arc-vert.wgsl", "energy-arc-frag.wgsl"],
        ["field-line-vert.wgsl", "field-line-frag.wgsl"],
