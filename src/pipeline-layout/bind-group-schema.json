      ]
    },
    "ssr": {
      "pipelines": [["ssr-compute.wgsl"]],
      "entries": [
        [0, "C", "texture-depth"], [1, "C", "texture"], [2, "C", "sampler"], [3, "C", "uniform"],
        [4, "C", "storage-texture", "rgba16float"], [5, "C", "texture"]
      ]
    },
    "iblPrefilter": {
      "pipelines": [["ibl-prefilter-compute.wgsl"]],
      "entries": [[0, "C", "uniform"], [1, "C", "storage-texture-array", "rgba16float"]]
