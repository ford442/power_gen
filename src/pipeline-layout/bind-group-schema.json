      "pipelines": [["bloom-vert.wgsl", "taa-resolve.wgsl"]],
      "entries": [[0, "F", "texture"], [1, "F", "texture"], [2, "F", "sampler"], [3, "F", "texture-depth"], [4, "F", "uniform"]]
    },
    "depthResolve": {
      "pipelines": [["depth-resolve.wgsl"]],
