    },
    "fdtdCompute": {
      "pipelines": [["fdtd-tmz-compute.wgsl"]],
      "entries": [[0, "C", "uniform"], [1, "C", "storage"], [2, "C", "storage"], [3, "C", "storage"], [4, "C", "storage-ro"]]
    },
    "fdtdSlice": {
      "pipelines": [["fdtd-slice.wgsl"]],
      "entries": [
        [0, "V", "uniform"], [1, "VF", "uniform"], [2, "F", "uniform"],
        [3, "F", "storage-ro"], [4, "F", "storage-ro"], [5, "F", "storage-ro"], [6, "F", "storage-ro"]
      ]
    }
  },
  "unboundPasses": {
    "$comment": "Pass files that are not part of any production pipeline layout (check:bindings fails on any other unmapped pass).",
    "core-vert.wgsl": "legacy core module; no pipeline built on it",
    "core-frag.wgsl": "legacy core module; no pipeline built on it"
  }
