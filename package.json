{
  "name": "seg-webgpu-visualizer",
  "version": "1.0.0",
  "description": "Real-time WebGPU simulation of the Searl Effect Generator with extensible architecture",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "src/main.ts",
  "scripts": {
    "postinstall": "npm ci --prefix tools/lint --no-audit --no-fund --loglevel=error",
    "dev": "vite",
    "build:site": "vite build",
    "build_colab": "bash scripts/build-colab.sh",
    "build": "npm run wasm:build && npm run build:site",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.js.json",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js",
    "codegen:constants": "node scripts/codegen-physics-constants.mjs",
    "check:constants": "node scripts/codegen-physics-constants.mjs --check",
    "codegen:catalog": "node scripts/codegen-device-catalog.mjs",
    "check:catalog": "node scripts/codegen-device-catalog.mjs --check",
    "codegen:lab-config": "node scripts/codegen-lab-config.mjs",
    "check:lab-config": "node scripts/codegen-lab-config.mjs --check",
    "generate:housing-glb": "node scripts/generate-seg-housing-glb.mjs",
    "generate:coil-former-glb": "node scripts/generate-seg-coil-former-glb.mjs",
    "generate:stand-glb": "node scripts/generate-seg-stand-glb.mjs",
    "generate:base-plate-glb": "node scripts/generate-seg-base-plate-glb.mjs",
    "generate:seg-gltf": "npm run generate:housing-glb && npm run generate:coil-former-glb && npm run generate:stand-glb && npm run generate:base-plate-glb",
    "generate:transformer-core-glb": "node scripts/generate-transformer-core-glb.mjs",
    "generate:vdg-terminal-glb": "node scripts/generate-vdg-terminal-glb.mjs",
    "generate:thomson-stand-glb": "node scripts/generate-thomson-stand-glb.mjs",
    "generate:quanta-gltf": "npm run generate:transformer-core-glb && npm run generate:vdg-terminal-glb && npm run generate:thomson-stand-glb",
    "generate:heron-vessels-glb": "node scripts/generate-heron-vessels-glb.mjs",
    "generate:kelvin-jars-glb": "node scripts/generate-kelvin-jars-glb.mjs",
    "generate:lab-gltf": "npm run generate:heron-vessels-glb && npm run generate:kelvin-jars-glb",
    "generate:gltf": "npm run generate:seg-gltf && npm run generate:quanta-gltf && npm run generate:lab-gltf",
    "check:wgsl": "bash scripts/check-wgsl.sh",
    "codegen:bindings": "node scripts/codegen-bindings.mjs",
    "check:bindings": "node scripts/check-bindings.mjs",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test -c playwright.preview.config.js",
    "test:unit": "node --test --test-reporter=spec \"scripts/tests/*.test.mjs\"",
    "test:coverage": "node --enable-source-maps --test --experimental-test-coverage --test-coverage-exclude=\"scripts/**\" \"scripts/tests/*.test.mjs\"",
    "test:chores": "node --test scripts/tests/chores.test.mjs",
    "test:device-mixins": "node --test scripts/tests/device-mixins.test.mjs",
    "test:fdtd": "node --test scripts/tests/fdtd.test.mjs",
    "test:transports": "node --test scripts/tests/transports.test.mjs",
    "test:firmware-safety": "node --test scripts/tests/manual/firmware-safety.test.mjs",
    "test:audio": "node --test scripts/tests/audio.test.mjs",
    "test:props": "node --test scripts/tests/props.test.mjs",
    "test:golden": "node --test scripts/tests/golden.test.mjs",
    "test:wasm-abi": "node --test scripts/tests/wasm-abi.test.mjs",
    "test:snapshots": "node --test scripts/tests/snapshots.test.mjs",
    "test:twin-snapshot": "node --test scripts/tests/twin-snapshot.test.mjs",
    "test:plant-worker": "node --test scripts/tests/plant-worker.test.mjs",
    "test:coupling": "node --test scripts/tests/coupling.test.mjs",
    "test:pulse-coil": "node --test scripts/tests/pulse-coil.test.mjs",
    "test:drop-tube": "node --test scripts/tests/drop-tube.test.mjs",
    "test:lab-mode": "node --test scripts/tests/lab-mode.test.mjs",
    "test:lab-url": "node --test scripts/tests/lab-url.test.mjs",
    "test:lab-config": "node --test scripts/tests/lab-config.test.mjs",
    "test:analysis": "node --test scripts/tests/analysis.test.mjs",
    "test:experiments": "node --test scripts/tests/experiments.test.mjs",
    "test:experiments:live": "node --test scripts/tests/experiments-live.test.mjs",
    "test:camera-gestures": "node --test scripts/tests/camera-gestures.test.mjs",
    "test:classroom": "node --test scripts/tests/classroom.test.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "test:embed": "node --test scripts/tests/embed.test.mjs",
    "test:frame-clock": "node --test scripts/tests/frame-clock.test.mjs",
    "test:frame-graph": "node --test scripts/tests/frame-graph.test.mjs",
    "test:uniform-ring": "node --test scripts/tests/uniform-ring.test.mjs",
    "test:device-draws": "node --test scripts/tests/device-draws.test.mjs",
    "test:stacked-prs": "node scripts/check-stacked-prs.mjs --self-test",
    "validate": "node scripts/validate.mjs",
    "deploy": "npm run build:site && python deploy.py",
    "wasm:build": "bash scripts/build-wasm.sh",
    "wasm:build-debug": "bash scripts/build-wasm.sh --debug",
    "wasm:native": "bash scripts/build-wasm.sh --native",
    "wasm:native:san": "bash scripts/native-san.sh",
    "check:post": "node scripts/check-post-contracts.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:entry-chunk": "node scripts/check-entry-chunk.mjs"
  },
  "keywords": [
    "webgpu",
    "visualization",
    "physics",
    "searl-effect-generator"
  ],
  "author": "ford442",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/web-bluetooth": "^0.0.21",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ford442/power_gen.git"
  },
  "bugs": {
    "url": "https://github.com/ford442/power_gen/issues"
  },
  "homepage": "https://ford442.github.io/power_gen/",
  "dependencies": {
    "ktx-parse": "^2.0.0",
    "qrcode-generator": "1.4.4",
    "uplot": "1.6.32"
  }
}
