# Native compilation database from `cmake -S cpp -B cpp/build`.
# Does not replace `make native` / `npm run wasm:native` in CI.
# Every TU is in it — the generated C ABI (cpp/src/sim_core_abi.cpp) compiles
# natively too. `make -C cpp compile-db-wasm` adds an optional wasm32 view
# (see cpp/README.md → Compilation database).
CompileFlags:
  Add: [-DSIM_CORE_STANDALONE]
CompilationDatabase: cpp/build
